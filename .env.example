# ─────────────────────────────────────────────────────────────
# Resona — environment
# Every variable is optional. Unset features degrade to a clearly
# labelled state rather than an error, so `npm run dev` works as-is.
# Copy to .env.local and fill in what you need.
# ─────────────────────────────────────────────────────────────

# Model backend --------------------------------------------------
# When set, /api/analyze forwards audio to <BACKEND_API_URL>/predict.
# When unset, the route returns deterministic demo output, labelled
# as a simulation in the UI. No audio is analysed in that state.
BACKEND_API_URL=https://your-model-service.example.com

# Result assistant -----------------------------------------------
# Any OpenAI-compatible /v1 endpoint. The key stays server-side —
# the browser only ever talks to /api/chat.
# When unset, the assistant reports that it is not configured.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Authentication -------------------------------------------------
# Firebase email/password, used only by the referral flow.
# Create a project at https://console.firebase.google.com, enable
# Email/Password under Authentication > Sign-in method, then paste
# the web app config below.
# When unset, sign-in falls back to a browser-local sandbox account
# so the rest of the app stays explorable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
